warnings.filterwarnings('ignore')


df = pd.read_csv('heart.csv')


df.head()





df.shape


df.info()


df.describe()


df.duplicated().sum()


df['HeartDisease'].value_counts().plot(kind='bar')


df.isnull().sum()


def plotting(var,num):
    plt.subplot(2,2,num)
    sns.histplot(df[var],kde=True)
    
plotting('Age',1)
plotting('RestingBP',2)
plotting('Cholesterol',3)
plotting('MaxHR',4)

plt.tight_layout()    


df['Cholesterol'].value_counts()


ch_mean = df.loc[df['Cholesterol'] !=0,'Cholesterol'].mean()


ch_mean


df['Cholesterol']=df['Cholesterol'].replace(0,ch_mean)
df['Cholesterol']=df['Cholesterol'].round(2)


reasting_bp_mean = df.loc[df['RestingBP'] !=0,'RestingBP'].mean()


reasting_bp_mean


df['RestingBP']=df['RestingBP'].replace(0,reasting_bp_mean)
df['RestingBP']=df['RestingBP'].round(2)


def plotting(var,num):
    plt.subplot(2,2,num)
    sns.histplot(df[var],kde=True)
    
plotting('Age',1)
plotting('RestingBP',2)
plotting('Cholesterol',3)
plotting('MaxHR',4)

plt.tight_layout() 


sns.countplot(x=df['Sex'],hue=df['HeartDisease'])


sns.countplot(x=df['ChestPainType'],hue=df['HeartDisease'])


sns.countplot(x=df['FastingBS'],hue=df['HeartDisease'])


sns.boxplot(x='HeartDisease',y='Cholesterol',data=df)


sns.violinplot(x='HeartDisease',y='Age',data=df)


sns.heatmap(df.corr(numeric_only=True),annot=True)





df_encode =pd.get_dummies(df,drop_first=True)


df_encode


df_encode = df_encode.astype(int)


df_encode


# Sklearn se StandardScaler import kar rahe hain taaki features ko normalize kiya ja sake
from sklearn.preprocessing import StandardScaler

# Un columns ki list jinhe scale karna hai (sirf continuous numerical variables)
numerical_cols = ['Age', 'RestingBP', 'Cholesterol', 'MaxHR', 'Oldpeak']

# Scaler ka object create kiya
scaler = StandardScaler()

# Selected columns par 'Z-score normalization' apply kar rahe hain 
# Isse har column ka mean = 0 aur standard deviation = 1 ho jayega
df_encode[numerical_cols] = scaler.fit_transform(df_encode[numerical_cols])

# Scaling ke baad data ka initial look check kar rahe hain
df_encode.head()



